# Copy to backend/.env (ignored by git) and load it with: set -a; . ./.env; set +a
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&pool_max_conns=10
# Supabase (Dashboard > Connect). Session pooler: IPv4, for a server that stays running (local, VPS, Fly, Render):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&pool_max_conns=10
# Transaction pooler: for serverless hosts (Cloud Run, etc.); simple protocol is required there:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=simple_protocol
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
TOKEN_TTL=72h
PORT=8080
CORS_ORIGIN=*
# The dummy label rules are not approved by a nutritionist; only use drafts locally.
ALLOW_DRAFT_LABEL_RULES=true

# --- AI Coach (Ollama Cloud) ---
# Paste your key from https://ollama.com/settings/keys (signed in with the account that should pay for usage).
# Empty = the coach stays rule-based. Check the key with: bash scripts/check_ollama.sh
# Keep the key on the server only: never in the Flutter app, an APK or git.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# Past this the coach answers from its rules instead (the app gives up after 20s).
OLLAMA_TIMEOUT=12s
# Scan Meal photos: a vision model on the same account (gemma4:31b is the one in the free plan).
OLLAMA_VISION_MODEL=gemma4:31b
# Past this a photo analysis fails with a "try again" message (the app waits 45s for this request).
OLLAMA_VISION_TIMEOUT=30s
# Optional, for a local `ollama serve` without a key (model then e.g. gpt-oss:120b-cloud):
# OLLAMA_BASE_URL=http://localhost:11434
