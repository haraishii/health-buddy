# Copy to backend/.env (ignored by git) and load it with: set -a; . ./.env; set +a
DATABASE_URL=postgres://healthbuddy:healthbuddy@localhost:5432/healthbuddy?sslmode=disable
# Supabase (Dashboard > Connect). Session pooler: IPv4, for a server that stays running (local, VPS, Fly, Render):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&pool_max_conns=10
# Transaction pooler: for serverless hosts (Cloud Run, etc.); simple protocol is required there:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=simple_protocol
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
TOKEN_TTL=72h
PORT=8080
CORS_ORIGIN=*
# The dummy label rules are not approved by a nutritionist; only use drafts locally.
ALLOW_DRAFT_LABEL_RULES=true
